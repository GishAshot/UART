   PORT ( 
          CLK	:	IN	STD_LOGIC; 
			 CNT_2_OUT	:	OUT STD_LOGIC;
			 F_6_25_MHZ : IN STD_LOGIC;
			 ---------ram_cs----------------------------------
			 CE1 : OUT  STD_LOGIC;
			 CE2 : OUT  STD_LOGIC;
			---------LEDS-------------------------------------
			 --LED : OUT STD_LOGIC_VECTOR(0 to 7);
			 ---------anodes-----------------------------------
          AN3	:	OUT	STD_LOGIC;
			 AN2	:	OUT	STD_LOGIC;
			 AN1	:	OUT	STD_LOGIC;
